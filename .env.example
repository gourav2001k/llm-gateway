# ── Auth ── shared bearer token your VS Code agent / clients must send as
# `Authorization: Bearer <value>`. Generate: openssl rand -hex 32
GATEWAY_API_KEY=

# ── Remote providers (free tiers, tried in this order) ──
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

OPENROUTER_API_KEY=
# Model used per gateway mode (see README below) — only OpenRouter needs to
# differ by mode since Groq/Gemini defaults already work for both.
# NOTE: OpenRouter's free model roster changes often — check openrouter.ai/models
# for current `:free` slugs if these stop working.
OPENROUTER_MODEL_CODE=cohere/north-mini-code:free
OPENROUTER_MODEL_CHAT=nvidia/nemotron-3-super-120b-a12b:free

# ── Local fallback (last resort, via Ollama) ──
ENABLE_LOCAL_FALLBACK=true
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b-instruct-q4_K_M

# ── Tuning ──
REQUEST_TIMEOUT_SECONDS=30
LOCAL_REQUEST_TIMEOUT_SECONDS=90

RATE_LIMIT_COOLDOWN_SECONDS=60
QUOTA_COOLDOWN_SECONDS=3600
SERVER_ERROR_COOLDOWN_SECONDS=15
CONFIG_ERROR_COOLDOWN_SECONDS=300
